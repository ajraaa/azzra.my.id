---
/**
 * Homepage — azzra.my.id
 * Requirements: 2.1, 2.2, 2.3, 2.4, 2.5, 2.6, 7.5, 7.6
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import DotGrid from '../components/visuals/DotGrid.astro';
import NodeLines from '../components/visuals/NodeLines.astro';
import HeroHeading from '../components/HeroHeading';
import ProjectList from '../components/ProjectList';
import { getCollection } from 'astro:content';

// Query featured projects (will return empty array until task 13 creates sample content)
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="azzra — Fullstack Developer"
  description="Fullstack developer specializing in end-to-end web application development, with a strong interest in blockchain technology and decentralized systems."
>
  <!-- Hero Section -->
  <section class="relative py-28 px-6 md:px-8">
    <div class="max-w-content mx-auto">
      <!-- DotGrid backdrop -->
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <DotGrid />
      </div>

      <!-- Animated heading -->
      <div class="mb-8">
        <div class="mb-4">
          <SectionLabel label="developer" />
        </div>
        <HeroHeading
          client:load
          name="azzra"
          role="Fullstack Developer"
          statement="I build web applications from end to end. Blockchain is where my interest runs deep, and where I'm headed."
        />
      </div>

      <!-- Social links -->
      <div class="flex gap-4 text-sm">
        <a
          href="https://github.com/ajraaa"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          GitHub ↗
        </a>
        <a
          href="https://www.linkedin.com/in/satria-azzra/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          LinkedIn ↗
        </a>
        <a
          href="/resume.pdf"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          Resume ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Engineering Focus Section -->
  <section class="py-24 px-6 md:px-8 border-t border-border">
    <div class="max-w-content mx-auto">
      <div class="mb-6">
        <SectionLabel label="focus" />
      </div>

      <div class="relative">
        <!-- Optional NodeLines decorative aside -->
        <div class="hidden md:block absolute -right-0 top-0">
          <NodeLines />
        </div>

        <div class="prose dark:prose-invert max-w-none">
          <p class="text-base text-fg leading-relaxed mb-4">
            I build web applications end-to-end — React, Next.js, Astro, Node.js, TypeScript. 
            Frontend to backend, I handle the full picture and make sure everything fits together well.
          </p>

          <p class="text-base text-fg leading-relaxed">
            Blockchain is something I genuinely care about. I've been learning Solidity and diving into 
            how decentralized applications are built. It's the direction I'm heading, and I'm putting 
            real time into it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section class="py-24 px-6 md:px-8 border-t border-border">
    <div class="max-w-wide mx-auto">
      <div class="mb-6">
        <SectionLabel label="selected work" />
      </div>

      {featuredProjects.length > 0 ? (
        <>
          <ProjectList client:load>
            {featuredProjects.map((project) => (
              <ProjectEntry
                title={project.data.title}
                summary={project.data.summary}
                tech={project.data.tech}
                date={project.data.date}
                status={project.data.status}
                slug={project.id}
                category={project.data.category}
              />
            ))}
          </ProjectList>

          <div class="mt-8">
            <a
              href="/projects"
              class="text-sm text-muted hover:text-accent transition-colors duration-150 ease-in-out"
            >
              View all projects →
            </a>
          </div>
        </>
      ) : (
        <p class="text-sm text-muted">Featured projects will appear here once content is added.</p>
      )}
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 px-6 md:px-8 border-t border-border">
    <div class="max-w-content mx-auto">
      <div class="mb-6">
        <SectionLabel label="contact" />
      </div>

      <div class="flex flex-col gap-3 text-sm">
        <a
          href="mailto:azzra@example.com"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          sat.azzra@gmail.com
        </a>
        <div class="flex gap-4">
          <a
            href="https://github.com/ajraaa"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
          >
            GitHub
          </a>
          <span class="text-border">·</span>
          <a
            href="https://www.linkedin.com/in/satria-azzra/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

