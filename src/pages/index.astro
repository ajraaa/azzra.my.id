---
/**
 * Homepage — azzra.my.id
 * Requirements: 2.1, 2.2, 2.3, 2.4, 2.5, 2.6, 7.5, 7.6
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import DotGrid from '../components/visuals/DotGrid.astro';
import NodeLines from '../components/visuals/NodeLines.astro';
import HeroHeading from '../components/HeroHeading';
import { getCollection } from 'astro:content';

// Query featured projects (will return empty array until task 13 creates sample content)
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="azzra — Fullstack Developer"
  description="Fullstack developer specializing in end-to-end web application development, with a strong interest in blockchain technology and decentralized systems."
>
  <!-- Hero Section -->
  <section class="relative py-28 px-6 md:px-8">
    <div class="max-w-content mx-auto">
      <!-- DotGrid backdrop -->
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <DotGrid />
      </div>

      <!-- Animated heading -->
      <div class="mb-8">
        <div class="mb-4">
          <SectionLabel label="developer" />
        </div>
        <HeroHeading
          client:load
          name="azzra"
          role="Fullstack Developer"
          statement="Fullstack developer focused on building practical and maintainable systems, with a strong interest in blockchain, decentralized technologies, and AI-assisted software engineering."
        />
      </div>

      <!-- Social links -->
      <div class="flex gap-4 text-sm">
        <a
          href="https://github.com/ajraaa"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          GitHub ↗
        </a>
        <a
          href="https://www.linkedin.com/in/satria-azzra/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          LinkedIn ↗
        </a>
        <a
          href="/resume.pdf"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          Resume ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Engineering Focus Section -->
  <section class="py-24 px-6 md:px-8 border-t border-border">
    <div class="max-w-content mx-auto">
      <div class="mb-6">
        <SectionLabel label="focus" />
      </div>

      <div class="relative">
        <!-- Optional NodeLines decorative aside -->
        <div class="hidden md:block absolute -right-0 top-0">
          <NodeLines />
        </div>

        <div class="prose dark:prose-invert max-w-none">
          <p class="text-base text-fg leading-relaxed mb-4">
            I'm a fullstack developer who enjoys building web applications from end to end, from frontend 
            interfaces to backend systems and application architecture. Most of the projects I've worked on 
            focus on building systems that are practical, maintainable, and thoughtfully engineered with 
            attention to both functionality and long-term scalability.
          </p>

          <p class="text-base text-fg leading-relaxed mb-4">
            Over time, I've developed a strong interest in blockchain and decentralized technologies. What 
            started as curiosity gradually became a deeper technical focus on distributed systems, smart 
            contracts, and how decentralized applications are designed and implemented in real-world 
            environments. It's a field I continue to explore seriously through continuous learning and 
            hands-on development.
          </p>

          <p class="text-base text-fg leading-relaxed">
            My workflow combines solid software engineering fundamentals with modern AI-assisted development 
            tools to accelerate research, prototyping, and implementation. I see AI as a tool that enhances 
            productivity and iteration speed while still relying on strong technical understanding, system 
            thinking, and careful engineering decisions throughout the development process.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work Section -->
  <section class="py-24 px-6 md:px-8 border-t border-border">
    <div class="max-w-wide mx-auto">
      <div class="mb-6">
        <SectionLabel label="selected work" />
      </div>

      {featuredProjects.length > 0 ? (
        <>
          <div class="flex flex-col gap-3">
            {featuredProjects.map((project) => (
              <ProjectEntry
                title={project.data.title}
                summary={project.data.summary}
                tech={project.data.tech}
                date={project.data.date}
                status={project.data.status}
                slug={project.id}
                category={project.data.category}
              />
            ))}
          </div>

          <div class="mt-8">
            <a
              href="/projects"
              class="text-sm text-muted hover:text-accent transition-colors duration-150 ease-in-out"
            >
              View all projects →
            </a>
          </div>
        </>
      ) : (
        <p class="text-sm text-muted">Featured projects will appear here once content is added.</p>
      )}
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-24 px-6 md:px-8 border-t border-border">
    <div class="max-w-content mx-auto">
      <div class="mb-6">
        <SectionLabel label="contact" />
      </div>

      <div class="flex flex-col gap-3 text-sm">
        <a
          href="mailto:sat.azzra@gmail.com"
          class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
        >
          sat.azzra@gmail.com
        </a>
        <div class="flex gap-4">
          <a
            href="https://github.com/ajraaa"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
          >
            GitHub
          </a>
          <span class="text-border">·</span>
          <a
            href="https://www.linkedin.com/in/satria-azzra/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-accent transition-colors duration-150 ease-in-out"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

