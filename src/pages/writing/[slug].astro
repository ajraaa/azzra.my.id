---
/**
 * Blog post detail page — /writing/[slug]
 *
 * Renders above-the-fold metadata (date, reading time, tags) followed by
 * the MDX body in prose typography. Only non-draft posts generate paths.
 *
 * Requirements: 6.3, 6.4
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { readingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { Content } = await render(post);

const readingMinutes = readingTime(post.body ?? '');
const formattedDate = post.data.date.toISOString().slice(0, 10);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <main class="max-w-content mx-auto px-6 md:px-8 py-16">
    <!-- Above-the-fold header block — Requirement 6.3, 6.4 -->
    <header>
      <SectionLabel label="writing" />
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight mt-4">{post.data.title}</h1>

      <!-- Metadata row: date · reading time -->
      <div class="flex items-center gap-3 mt-3 font-mono text-xs text-muted">
        <time datetime={formattedDate}>{formattedDate}</time>
        <span>·</span>
        <span>{readingMinutes} min read</span>
      </div>

      <!-- Tags row — chips linking to tag-filtered views -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map((tag) => (
            <a
              href={`/writing/tag/${tag}`}
              class="font-mono text-xs px-2 py-0.5 rounded border border-border text-muted hover:text-accent transition-colors duration-150"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <hr class="border-border my-10" />

    <!-- MDX body in prose typography -->
    <article class="prose dark:prose-invert max-w-none">
      <Content />
    </article>
  </main>
</BaseLayout>
