---
import TechBadge from './TechBadge.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  summary: string;
  tech: string[];
  date: Date;
  status: 'production' | 'archived' | 'in-progress';
  slug: string;
  category?: string;
}

const { title, summary, tech, date, status, slug, category } = Astro.props;

const formattedDate = date.toISOString().slice(0, 7);
---

<article class="project-card relative border border-border rounded-md overflow-hidden transition-colors duration-200 ease-in-out">
  <!-- Decorative dot grid — revealed on hover -->
  <svg
    aria-hidden="true"
    class="project-card-dots pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-200"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id={`dots-${slug}`} x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="hsl(var(--code-fg))" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#dots-${slug})`} />
  </svg>

  <a href={`/projects/${slug}`} aria-label={`View ${title} case study`} class="relative block p-4 md:p-5">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 md:gap-6">
      <!-- Left: status + title + summary -->
      <div class="flex flex-col gap-1.5">
        <div>
          <StatusBadge status={status} />
        </div>
        <h3 class="text-base font-semibold text-fg">{title}</h3>
        <p class="text-sm text-muted">{summary}</p>
      </div>

      <!-- Right: category + tech badges + date + arrow -->
      <div class="flex flex-col gap-2 md:items-end md:text-right">
        {category && (
          <span class="font-mono text-xs text-muted">{category}</span>
        )}
        <div class="flex flex-wrap gap-1.5 md:justify-end">
          {tech.map((t) => <TechBadge tech={t} />)}
        </div>
        <div class="flex items-center gap-2 md:justify-end">
          <span class="font-mono text-xs text-muted">{formattedDate}</span>
          <span class="project-card-arrow text-muted text-sm leading-none transition-colors duration-200">↗</span>
        </div>
      </div>
    </div>
  </a>
</article>

<style is:global>
  .project-card:hover {
    border-color: hsl(var(--fg) / 0.25);
    background-color: hsl(var(--bg-subtle));
  }
  .project-card:hover .project-card-dots {
    opacity: 0.1;
  }
  .project-card:hover .project-card-arrow {
    color: hsl(var(--code-fg));
  }
</style>
