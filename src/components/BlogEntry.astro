---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  readingTimeMinutes: number;
  slug: string;
}

const { title, description, date, tags, readingTimeMinutes, slug } = Astro.props;

const formattedDate = date.toISOString().slice(0, 10);
---

<article class="blog-card relative border border-border rounded-md overflow-hidden transition-colors duration-200 ease-in-out">
  <!-- Decorative dot grid — revealed on hover -->
  <svg
    aria-hidden="true"
    class="blog-card-dots pointer-events-none absolute inset-0 h-full w-full opacity-0 transition-opacity duration-200"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id={`dots-${slug}`} x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="hsl(var(--code-fg))" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#dots-${slug})`} />
  </svg>

  <a href={`/writing/${slug}`} aria-label={`Read ${title}`} class="relative block p-4 md:p-5">
    <div class="flex flex-col gap-2">
      <!-- Top row: date + reading time -->
      <div class="flex items-center justify-between gap-2">
        <time datetime={formattedDate} class="font-mono text-xs text-muted">{formattedDate}</time>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-muted">{readingTimeMinutes} min read</span>
          <span class="blog-card-arrow text-muted text-sm leading-none transition-colors duration-200">↗</span>
        </div>
      </div>

      <!-- Title -->
      <h3 class="text-base font-semibold text-fg">{title}</h3>

      <!-- Description -->
      <p class="text-sm text-muted">{description}</p>

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-1">
          {tags.map((tag) => (
            <span class="font-mono text-xs px-2 py-0.5 rounded border border-border text-muted">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

<style is:global>
  .blog-card:hover {
    border-color: hsl(var(--fg) / 0.25);
    background-color: hsl(var(--bg-subtle));
  }
  .blog-card:hover .blog-card-dots {
    opacity: 0.1;
  }
  .blog-card:hover .blog-card-arrow {
    color: hsl(var(--code-fg));
  }
</style>
