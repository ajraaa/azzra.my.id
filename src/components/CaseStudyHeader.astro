---
import SectionLabel from './SectionLabel.astro';
import TechBadge from './TechBadge.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  summary: string;
  tech: string[];
  status: 'production' | 'archived' | 'in-progress';
  category?: string;
  role?: string;
  repo?: string;
  demo?: string;
  decisions?: string[];
}

const {
  title,
  summary,
  tech,
  status,
  category,
  role,
  repo,
  demo,
  decisions,
} = Astro.props;

const labelText = `${category ?? 'project'} · ${status}`;
---

<div class="border border-border rounded-md p-6 bg-bg-subtle">
  <SectionLabel label={labelText} />

  <h1 class="text-2xl md:text-3xl font-bold tracking-tight mt-3 mb-2">
    {title}
  </h1>

  <p class="text-base text-muted mb-4">
    {summary}
  </p>

  {role && (
    <p class="font-mono text-sm text-muted mb-4">
      Role: {role}
    </p>
  )}

  {tech.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tech.map((t) => (
        <TechBadge tech={t} />
      ))}
    </div>
  )}

  {(repo || demo) && (
    <div class="flex flex-wrap gap-4 font-mono text-sm mb-4">
      {repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-150"
        >
          Repo ↗
        </a>
      )}
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted hover:text-accent transition-colors duration-150"
        >
          Demo ↗
        </a>
      )}
    </div>
  )}

  {decisions && decisions.length > 0 && (
    <div>
      <p class="font-mono text-sm text-muted mb-2">Key Decisions:</p>
      <ol class="list-decimal list-inside space-y-1">
        {decisions.map((decision) => (
          <li class="font-mono text-sm text-muted">{decision}</li>
        ))}
      </ol>
    </div>
  )}
</div>
