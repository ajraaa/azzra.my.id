---
// No props — purely decorative network/protocol diagram element
---

<svg
  aria-hidden="true"
  class="pointer-events-none opacity-[0.35]"
  width="200"
  height="160"
  viewBox="0 0 200 160"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
>
  <!-- Connection lines -->
  <line x1="30"  y1="30"  x2="100" y2="60"  stroke="hsl(var(--muted))" stroke-width="1" />
  <line x1="100" y1="60"  x2="170" y2="30"  stroke="hsl(var(--muted))" stroke-width="1" />
  <line x1="100" y1="60"  x2="100" y2="130" stroke="hsl(var(--muted))" stroke-width="1" />
  <line x1="30"  y1="30"  x2="30"  y2="110" stroke="hsl(var(--muted))" stroke-width="1" />
  <line x1="30"  y1="110" x2="100" y2="130" stroke="hsl(var(--muted))" stroke-width="1" />
  <line x1="170" y1="30"  x2="170" y2="110" stroke="hsl(var(--muted))" stroke-width="1" />

  <!-- Nodes -->
  <circle cx="30"  cy="30"  r="3" fill="hsl(var(--muted))" />
  <circle cx="170" cy="30"  r="3" fill="hsl(var(--muted))" />
  <circle cx="100" cy="60"  r="3" fill="hsl(var(--muted))" />
  <circle cx="30"  cy="110" r="3" fill="hsl(var(--muted))" />
  <circle cx="170" cy="110" r="3" fill="hsl(var(--muted))" />
  <circle cx="100" cy="130" r="3" fill="hsl(var(--muted))" />
</svg>
