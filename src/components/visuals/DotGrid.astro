---
// No props — purely decorative background element
---

<svg
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 z-0 h-full w-full opacity-[0.25]"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <pattern id="dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="1" fill="hsl(var(--muted))" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#dots)" />
</svg>
