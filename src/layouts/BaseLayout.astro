---
/**
 * BaseLayout.astro — shared page shell
 *
 * Composes: pre-paint theme script, SEO, Nav, Footer, and a default slot.
 * Requirements: 1.1, 1.5, 7.1, 7.2, 8.1, 8.2, 8.3, 8.4
 */

import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** Page title passed to <SEO /> */
  title: string;
  /** Meta description passed to <SEO /> */
  description: string;
  /** Absolute URL for og:image */
  ogImage?: string;
  /** Canonical URL override */
  canonicalURL?: string;
}

const { title, description, ogImage, canonicalURL } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!--
      Pre-paint theme script — MUST be first in <head>, before any stylesheet,
      to prevent flash of unstyled content (FOUC).
      Reads localStorage.theme → prefers-color-scheme → dark default.
      Requirement 1.5
    -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
        // Set theme-color for browser chrome / mobile status bar
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', t === 'light' ? '#f4f6f8' : '#0d0f14');
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Initial value is dark default; inline script above corrects it before paint -->
    <meta name="theme-color" content="#0d0f14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- SEO: title, description, Open Graph, canonical — Requirements 8.1–8.3 -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
    />
  </head>

  <body class="bg-bg text-fg min-h-screen flex flex-col">
    <!-- Sticky navigation bar — Requirement 1.1, 1.6 -->
    <Nav />

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer — Requirement 1.1 -->
    <Footer />
  </body>
</html>
